<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:background="#1E293B">

    <ImageView
        android:id="@+id/ivGalleryThumb"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:contentDescription="相册图片"
        android:scaleType="centerCrop" />

    <!-- 选中高亮遮罩 -->
    <View
        android:id="@+id/viewSelectedOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#551E88E5"
        android:visibility="gone" />

    <!-- 右上角选择顺序编号圆圈 -->
    <TextView
        android:id="@+id/tvOrderBadge"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_badge_unselected"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="1" />

    <!-- 右下角放大预览按钮 -->
    <ImageButton
        android:id="@+id/btnZoomPreview"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:background="#99000000"
        android:contentDescription="放大预览"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_zoom_in" />

</FrameLayout>
